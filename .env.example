OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
EMBED_MODEL=nomic-embed-text
OLLAMA_API_KEY=
SSH_HOST=
SSH_PORT=22
SSH_KEY=

# GitHub App — value set per environment (dev in .env.dev, prod from the server's secret store)
GITHUB_WEBHOOK_SECRET=

# Serve-allowlist: comma-separated GitHub org IDs Herald serves
SERVE_ALLOWLIST=

# GitHub App identity — App ID + path to the .pem private key (key stored outside the repo)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
MIRROR_ROOT=

# Base directory for code-bootstrap drafts (generated, LLM-unreviewed, never committed
# as-is); a relative path lands inside Herald's own working tree
BOOTSTRAP_DRAFT_ROOT=

# Per-repo canonical-ref override (repo name -> branch), e.g. {"repo-name":"main"};
# a repo not listed here uses its mirror's default branch instead
CANONICAL_REFS=

# GitHub org id -> login, e.g. {"244165546":"mind-systems"}; used to build each
# mirrored repo's HTTPS clone URL
GITHUB_ORG_LOGINS=

# Operator-declared project-graph edges: comma-separated from>to:kind triples;
# kind is one of CONTRACT/AUTH/DEPENDENCY (case-insensitive, normalized to
# upper-case), e.g. PROJECT_EDGES=mind_api>mind_mobile:CONTRACT
PROJECT_EDGES=

# Herald's own Postgres (pgvector-enabled) — knowledge store + relational state
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Retrieval size used for both the knowledge and episodic store queries in the reasoner
REASONER_K=8
